[Unit]
# systemd unit for the chota kiosk server.
#
# A template: deploy/bootstrap.sh fills in @USER@ and @HOME@ (the account chota
# runs as, and its home) and installs it as /etc/systemd/system/chota.service.
# By hand, from the repo root:
#   sed -e "s|@USER@|$USER|g" -e "s|@HOME@|$HOME|g" deploy/chota.service \
#     | sudo tee /etc/systemd/system/chota.service >/dev/null
#   sudo systemctl daemon-reload && sudo systemctl enable --now chota
# The repo must be at @HOME@/code/chota-bot. After deploy/deploy.sh rebuilds,
# it `systemctl restart`s us. Editing this file takes effect only after the
# install above is run again.
Description=Chota kiosk server (SvelteKit / adapter-node)
# `network.target` (not network-online): we're a server, not a client — no need
# for a routable address to start. Per systemd.io/NETWORK_ONLINE: "server
# software should generally remain available even if a routable network
# interface is not yet ready."
After=network.target

# Disable the default start rate limit (5 starts in 10s → permanently dead).
# A bad deploy or a port-bind race shouldn't brick the service until someone
# SSHes in to `systemctl reset-failed`. We'd rather it keeps trying forever.
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
WorkingDirectory=@HOME@/code/chota-bot

# .env is the single source of truth for runtime config (PORT, ORIGIN, KIOSK,
# all the API keys). It's gitignored and must be copied over manually — see
# docs/deploy.md.
EnvironmentFile=@HOME@/code/chota-bot/.env

# Cron patterns are pinned to Sydney in scheduler.ts, but any code reading the
# local clock (getHours(), toLocaleDateString()) follows the process TZ — and a
# fresh Pi OS box may be on UTC. Pin it here too.
Environment=TZ=Australia/Sydney

# Bun's bin first (bun itself, and the global `agent-browser` chota runs for
# screenshots and the Sentral login, from `bun add -g`). The rest is the
# standard systemd default PATH.
Environment=PATH=@HOME@/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin


# adapter-node build output, run on Bun. Boots SvelteKit on $PORT (8000 in
# .env, behind Caddy). `bun upgrade` updates the binary in place. systemd
# doesn't expand `~`, hence the absolute path.
ExecStart=@HOME@/.bun/bin/bun @HOME@/code/chota-bot/build/index.js

Restart=on-failure
RestartSec=5

# Logs go to journald — `journalctl -u chota -f` to tail. (When LogTape lands,
# our own structured logs will write to data/logs/chota.log alongside this.)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
