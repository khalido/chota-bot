# Weekly Soloist update. Builds expire 90 days after they're built, and new
# ones appear about weekly. Persistent: a week missed while the box was off
# runs at the next boot.
[Unit]
Description=Weekly Spotify Soloist update

[Timer]
OnCalendar=weekly
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
