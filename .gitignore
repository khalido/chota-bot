# Data — runtime state, all gitignored except data/quotes/ (vendored from
# the curios repo via scripts/sync-quotes.mjs — deterministic, fine to track).
# New tool-specific subdirs (data/sentral/, data/morning/, etc.) are auto-
# ignored by this rule; no need to add them one-by-one.
/data/*
!/data/quotes/

# Per-family config (root, gitignored). chota.config.example.ts is committed.
/chota.config.ts

# Private notes (account IDs, project numbers, anything you'd rather not push)
/docs/private.md
/docs/private/

# Claude Code skill artifacts — per-developer tooling, not part of the app
/skills-lock.json
/.agents/
