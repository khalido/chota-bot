node_modules

# Output
.output
.vercel
.netlify
.wrangler
/.svelte-kit
/build

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
# SQLite
*.db

# drizzle-kit's generated migration SQL — recreated by `deploy.sh`'s fresh-DB
# path (npx drizzle-kit generate) on each box, so tracking it would create
# false-positive diffs after every deploy. Schema lives in
# src/lib/server/db/auth.schema.ts (tracked).
/drizzle/

# Data — runtime state, all gitignored. Vendored content (quotes, puzzles)
# now lives in the sibling curios repo at ~/code/curios; loaded directly
# from ../curios/dist/*. New tool-specific subdirs (data/sentral/,
# data/morning/, etc.) are auto-ignored by this rule.
/data/*

# Per-family config (root, gitignored). chota.config.example.ts is committed.
/chota.config.ts

# Personalised agent personality (root, gitignored). soul.example.md is the
# public template; copy it to soul.md to write your family's flavour. The
# agent falls back to the example when soul.md is absent, so a fresh clone
# still works.
/soul.md

# Private notes (account IDs, project numbers, anything you'd rather not push)
/docs/private.md
/docs/private/

# Claude Code skill artifacts. skills-lock.json is per-developer state; the
# .agents/ tree itself is committed so a fresh clone picks up the project's
# installed agent skills (re-sync with `npx skills add <slug>` when upstream
# updates).
/skills-lock.json
