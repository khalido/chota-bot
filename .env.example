# Drizzle (sqlite, gitignored via *.db)
DATABASE_URL=data/home.db

# App URL — the kiosk runs on a fixed port (8000, pinned in vite.config.ts).
# Also the base for the better-auth OAuth redirect URIs you register with Google/etc.
ORIGIN="http://localhost:8000"

# Better Auth (32 chars, high entropy — see https://www.better-auth.com/docs/installation)
BETTER_AUTH_SECRET=""

# Transport NSW (https://opendata.transport.nsw.gov.au/)
TRANSPORT_NSW_API_KEY=""
# bus stops/routes live in chota.config.ts (typed, gitignored, family-specific)

# Google Weather (https://developers.google.com/maps/documentation/weather)
GOOGLE_WEATHER_API_KEY=""

# Vercel AI Gateway (https://vercel.com/docs/ai-gateway)
# Single key, multi-provider routing. Don't set provider-specific keys
# (OPENAI_API_KEY, ANTHROPIC_API_KEY, etc.) — Gateway proxies them all.
AI_GATEWAY_API_KEY=""

# Google OAuth (better-auth Google provider — for calendar access)
# GCP Console → Credentials → OAuth client ID → Web application
# Authorized redirect URI: http://localhost:8000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# TickTick MCP (https://help.ticktick.com/articles/7438129581631995904)
# Generate an API key in TickTick → Account settings → MCP.
# We hit the hosted MCP at https://mcp.ticktick.com with this as a Bearer token.
TICKTICK_API_KEY=""

# Sentral (NSW Dept of Ed school portal). Login is SAML→Microsoft→NSW DoE ADFS.
# EMAIL/PASSWORD drive the agent-browser auto-login — the tool logs in itself
# and caches the session cookie in data/sentral/<name>-cookie.txt, refreshing
# it whenever it expires. STUDENT_ID is in the timetable URL
# (.../portal/#!/timetable/3310 → "3310"). COOKIE is optional — a bootstrap
# cookie skips the first login. Add a block per kid; the tool reads
# SENTRAL_<UPPERNAME>_*.
SENTRAL_BASE_URL="https://yourschool.sentral.com.au/s-xxxxxx"
SENTRAL_KID1_EMAIL="firstkid.lastname@education.nsw.gov.au"
SENTRAL_KID1_PASSWORD=""
SENTRAL_KID1_STUDENT_ID=""
SENTRAL_KID1_COOKIE=""

# TMDB (https://developer.themoviedb.org/docs/getting-started)
# Settings → API → request a v4 read access token (Bearer).
TMDB_READ_ACCESS_TOKEN=""

# NASA APOD (https://api.nasa.gov/) — Astronomy Picture of the Day.
# Falls back to NASA's shared DEMO_KEY (low rate limit) if blank.
NASA_API_KEY=""

# KIOSK gate — set to "true" ONLY on the kiosk box. Some jobs (the morning
# print, anything destructive in future) check this and no-op when it's blank,
# so they don't fire on dev machines.
KIOSK=""
