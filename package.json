{
	"name": "chota-bot",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest --run",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"deploy": "bash deploy/push.sh",
		"logs": "ssh chota 'sudo journalctl -u chota -f'"
	},
	"devDependencies": {
		"@ai-sdk/svelte": "^5.0.142",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.16.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24.19.2",
		"auth": "^1.7.10",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@grammyjs/auto-retry": "^2.0.2",
		"@logtape/file": "^2.0.9",
		"@logtape/logtape": "^2.0.9",
		"@logtape/otel": "^2.1.1",
		"@napi-rs/canvas": "^1.0.0",
		"@oxidezap/baileyrs": "^0.3.11",
		"ai": "^7.0.142",
		"better-auth": "^1.7.10",
		"better-sqlite3": "^13.0.3",
		"cheerio": "^1.2.0",
		"croner": "^10.0.1",
		"exa-js": "^2.25.0",
		"googleapis": "^186.0.0",
		"grammy": "^1.45.0",
		"lru-cache": "^11.5.3",
		"node-ical": "^0.27.3",
		"node-thermal-printer": "^4.6.0",
		"tmdb-ts": "^2.3.0",
		"usb": "^2.18.0",
		"zod": "^4.4.3"
	},
	"trustedDependencies": [
		"better-sqlite3",
		"esbuild",
		"usb"
	]
}
