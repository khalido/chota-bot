{
	"name": "chota-bot",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest --run",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"deploy": "bash deploy/push.sh",
		"logs": "ssh chota 'journalctl -u chota -f'"
	},
	"devDependencies": {
		"@ai-sdk/svelte": "^5.0.171",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.72.0",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.6",
		"auth": "1.7.22",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@grammyjs/auto-retry": "^2.0.2",
		"@khalido/home": "latest",
		"@logtape/file": "^2.4.2",
		"@logtape/logtape": "^2.4.2",
		"@logtape/otel": "^2.4.2",
		"@napi-rs/canvas": "^1.1.1",
		"@oxidezap/baileyrs": "^0.3.14",
		"@xdevplatform/xdk": "^0.6.6",
		"ai": "^7.0.171",
		"better-auth": "1.7.22",
		"better-sqlite3": "^13.1.1",
		"cheerio": "^1.2.0",
		"croner": "^11.0.0",
		"exa-js": "^2.28.0",
		"googleapis": "^189.0.0",
		"grammy": "^1.46.0",
		"lru-cache": "^11.5.3",
		"mathjs": "^15.2.0",
		"node-ical": "^0.27.6",
		"node-thermal-printer": "^4.6.1",
		"tmdb-ts": "^2.3.0",
		"unpdf": "^2.1.0",
		"usb": "^2.19.1",
		"zod": "^4.6.7"
	},
	"trustedDependencies": [
		"better-sqlite3",
		"esbuild",
		"usb"
	],
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}
